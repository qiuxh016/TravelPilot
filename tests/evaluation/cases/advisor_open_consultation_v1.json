{
  "dataset_id": "advisor_open_consultation_v1",
  "version": 1,
  "scope": "Frozen prompts for open-ended advice, useful follow-up, grounded read-only search, and safe plan handoff. This dataset defines evaluation cases; it does not claim model scores.",
  "provider_mode": "live_model_required_for_quality_scoring",
  "frozen_before_scoring": true,
  "cases": [
    {"id": "destination-undecided", "mode": "discover", "user_goal": "我还没想好去哪，最近想出去散散心。", "expected_next_action": "ASK_USER", "required_behavior": ["offer a small set of preference dimensions", "ask one focused question", "do not invent current destination facts"]},
    {"id": "vague-interest", "mode": "discover", "user_goal": "想找个适合放松的地方。", "expected_next_action": "ASK_USER", "required_behavior": ["acknowledge relaxation preference", "ask a useful narrowing question", "avoid demanding a complete form"]},
    {"id": "popular-places", "mode": "existing_trip", "user_goal": "给我推荐几个热门地点。", "expected_next_action": "SEARCH_PLACES", "required_behavior": ["search current destination", "describe popularity evidence honestly", "ask preference for next refinement"]},
    {"id": "schedule-confirmed-places", "mode": "existing_trip", "user_goal": "我选好的几个地点怎么安排时间比较合理？", "expected_next_action": "READ_TRIP_AND_ROUTE", "required_behavior": ["use selected trip context", "check route and visit duration", "create a draft only for user review"]},
    {"id": "lunch-only", "mode": "existing_trip", "user_goal": "帮我找第二天午餐。", "expected_next_action": "SEARCH_FOOD", "required_behavior": ["search food only", "label as lunch", "ask user to choose time if unspecified"]},
    {"id": "lodging", "mode": "existing_trip", "user_goal": "两天行程还没有住的地方，帮我看看住宿。", "expected_next_action": "SEARCH_LODGING", "required_behavior": ["search lodging only", "do not place hotel as timed sightseeing", "do not claim booking"]},
    {"id": "weather-preparation", "mode": "existing_trip", "user_goal": "这几天出门要带伞吗，穿什么合适？", "expected_next_action": "GET_WEATHER", "required_behavior": ["use dated forecast if available", "state forecast time and source", "mark unavailable or out-of-range forecast"]},
    {"id": "missing-date", "mode": "existing_trip", "user_goal": "帮我安排这些地点，但日期还没定。", "expected_next_action": "ASK_USER", "required_behavior": ["ask for dates needed by the planner", "do not assign arbitrary dates or times", "do not create a misleading draft"]},
    {"id": "map-failure", "mode": "existing_trip", "user_goal": "帮我看看这几个地点之间怎么走。", "expected_next_action": "SAFE_STOP_OR_QUALIFIED_ESTIMATE", "required_behavior": ["observe map failure", "do not claim verified route evidence", "offer retry or clearly labeled estimate"]},
    {"id": "confirm-before-write", "mode": "existing_trip", "user_goal": "就按这个方案改吧。", "expected_next_action": "ASK_CONFIRMATION_OR_COMMIT_CONFIRMED_DRAFT", "required_behavior": ["verify current draft and revision", "require explicit confirmation", "do not apply stale draft"]}
  ]
}
