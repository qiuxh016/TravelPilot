        {"key": "morning", "category": "ATTRACTION", "day": "2026-10-01", "start": "09:00", "end": "10:00", "priority": 3},
        {"key": "next-day", "category": "ATTRACTION", "day": "2026-10-02", "start": "13:00", "end": "15:00", "priority": 3},
