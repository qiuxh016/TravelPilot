      "event_type": "WEATHER_CHANGE",
      "effective_at": "2026-10-01T12:00:00+08:00",
      "payload": {"condition": "RAIN"},
      "nodes": [
        {"key": "park", "category": "ATTRACTION", "day": "2026-10-01", "start": "13:00", "end": "15:00", "priority": 3, "environment_profile": {"exposure": "OUTDOOR", "sensitivity": {"RAIN": "HIGH"}, "source": "EDITORIAL", "confidence": 0.9}},
        {"key": "museum", "category": "ATTRACTION", "day": "2026-10-01", "start": "15:30", "end": "17:00", "priority": 4, "environment_profile": {"exposure": "INDOOR", "sensitivity": {"RAIN": "LOW"}, "source": "EDITORIAL", "confidence": 0.9}},
