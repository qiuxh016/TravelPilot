APP_ENV=development
REGISTRATION_INVITE_CODE=
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
WEB_BASE_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
DATABASE_URL=postgresql+asyncpg://travelpilot:travelpilot@localhost:5432/travelpilot
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:8000

MAPS_PROVIDER=fake
AMAP_API_KEY=
MAPS_TIMEOUT_SECONDS=8
# Optional text extraction model; local conservative extraction works without credentials.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
MEDIA_STORAGE_DIR=.data/media
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_UPLOAD_BYTES=10485760
# Optional SeaweedFS development profile: docker compose --profile media up -d seaweedfs
# Set MEDIA_STORAGE_BACKEND=s3 to enable; credentials below are development-only.
MEDIA_S3_BUCKET=travelpilot-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT_URL=http://127.0.0.1:8333
MEDIA_S3_ACCESS_KEY_ID=travelpilot-dev-access
MEDIA_S3_SECRET_ACCESS_KEY=travelpilot-dev-secret-change-me
