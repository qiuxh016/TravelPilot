# Copy to .env.production and replace every placeholder with a fresh secret.
# Never commit .env.production. DNS must point SITE_DOMAIN to this host; allow inbound 80/443.
SITE_DOMAIN=travel.example.com
POSTGRES_USER=travelpilot
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=travelpilot
REDIS_PASSWORD=replace-with-a-long-random-redis-password

APP_ENV=production
REGISTRATION_INVITE_CODE=replace-with-a-separate-invite-code
AUTH_RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
ADVISOR_DESTINATION_LIMIT_PER_USER=3
ADVISOR_DESTINATION_WINDOW_SECONDS=600
WEB_BASE_URL=https://travel.example.com
WEB_ALLOWED_ORIGINS=https://travel.example.com
SESSION_COOKIE_DOMAIN=

# SMTP provider credentials; use an account restricted to transactional mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=travelpilot@example.com
SMTP_USE_TLS=true

# Optional map and model providers. These stay server-side.
MAPS_PROVIDER=amap
AMAP_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS_PER_TURN=1200

# Private S3-compatible bucket. Restrict the credential to this bucket.
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_DIR=/var/lib/travelpilot/media
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_S3_BUCKET=travelpilot-private-media
MEDIA_S3_REGION=replace-with-bucket-region
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=replace-me
MEDIA_S3_SECRET_ACCESS_KEY=replace-me
